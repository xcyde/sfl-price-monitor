# Every environment has its own secrets: never reuse production values locally
# (a JWT signed with the production JWT_SECRET is accepted by the production api).

# Database
# Local: the db container from docker-compose.local.yml. Inside compose the overlay
# overrides this with postgres://sfl:sfl@db:5432/sfl; this value is for `node src/index.ts`.
DATABASE_URL=postgres://sfl:sfl@127.0.0.1:5432/sfl
# Production (server only): direct Neon endpoint, WITHOUT "-pooler" in the host — the process
# runs continuously and holds the connection open, so Neon's pgbouncer pooler is not needed;
# sslmode=require is mandatory for Neon
# DATABASE_URL=postgresql://user:password@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# External API
PRICES_API_URL=https://sfl.world/api/v1/prices
NFTS_API_URL=https://sfl.world/api/v1/nfts

# Server
PORT=3000

# JWT (access token)
JWT_SECRET=change_me_to_a_random_32_char_secret_key_here
JWT_ACCESS_TTL=15m

# Refresh token
REFRESH_TOKEN_TTL_DAYS=30

# Telegram bot shared secret (16 symbols minimum)
BOT_INTERNAL_SECRET=change_me_to_a_random_secret

# Telegram bot token from @BotFather. Locally use a separate dev bot: two processes polling
# with the same token get 409 Conflict and the production bot stops receiving updates.
TELEGRAM_BOT_TOKEN=

# Base URL of the API process that the bot calls over HTTP
# docker-compose overrides this automatically with http://api:PORT
# Keep as is for local development without compose
API_BASE_URL=http://127.0.0.1:3000

# Swagger UI (true = enabled; defaults to false when unset)
ENABLE_SWAGGER=false

